    "firmos": "./dist/src/daemon.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/daemon.js",
    "dev": "tsx src/daemon.ts",
    "publish": "tsx scripts/publish.ts",
    "publish:external": "tsx scripts/publish-external.ts",
    "reset:roles": "tsx scripts/reset-roles.ts",
    "reset:work": "tsx scripts/reset-work.ts",
    "reset:tickets": "tsx scripts/reset-tickets.ts",
    "reset:all": "npm run reset:roles && npm run reset:work && npm run reset:tickets && npm run purge:queue",
    "purge:queue": "tsx scripts/purge-queue.ts",
    "test": "node tests/config.test.js && node tests/styleguide.test.js && node tests/scripts/package-scripts.test.js && tsx tests/daemon.test.ts && tsx tests/tools/index.test.ts"
