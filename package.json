{
  "name": "firmos",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/daemon.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/daemon.js",
    "dev": "ts-node --esm src/daemon.ts",
    "publish": "ts-node --esm scripts/publish.ts",
    "publish:external": "ts-node --esm scripts/publish-external.ts",
    "reset:roles": "ts-node --esm scripts/reset-roles.ts",
    "reset:work": "ts-node --esm scripts/reset-work.ts",
    "purge:queue": "ts-node --esm scripts/purge-queue.ts",
    "test": "node tests/config.test.js && node tests/styleguide.test.js && node tests/scripts/package-scripts.test.js && ts-node --esm tests/daemon.test.ts && ts-node --esm tests/tools/index.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jameskranz/FirmOS.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jameskranz/FirmOS/issues"
  },
  "homepage": "https://github.com/jameskranz/FirmOS#readme",
  "dependencies": {
    "@google/genai": "^1.42.0",
    "@google/generative-ai": "^0.24.1",
    "amqplib": "^0.10.9",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^25.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
