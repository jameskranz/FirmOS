{
  "name": "firmos",
  "version": "1.0.0",
  "description": "",
  "main": "dist/daemon.js",
  "bin": {
    "firmos": "./dist/cli/index.js"
  },
  "scripts": {
    "prebuild": "npm test",
    "build": "tsc",
    "postbuild": "copyfiles -u 1 \"src/**/*.sql\" \"src/**/*.md\" dist/ && copyfiles \"runner-entrypoint.sh\" dist/",
    "start": "node dist/src/daemon.js",
    "dev": "tsx src/daemon.ts",
    "publish": "tsx scripts/publish.ts",
    "publish:external": "tsx scripts/publish-external.ts",
    "reset:roles": "tsx scripts/reset-roles.ts",
    "reset:work": "tsx scripts/reset-work.ts",
    "reset:tickets": "tsx scripts/reset-tickets.ts",
    "reset:all": "firmos reset --hard",
    "purge:queue": "tsx scripts/purge-queue.ts",
    "test": "node tests/config.test.js && node tests/styleguide.test.js && tsx tests/utils/path-resolver.test.ts && tsx tests/utils/model-resolver.test.ts && tsx tests/state/json.test.ts && tsx tests/tools/list-roles.test.ts && tsx tests/tools/ticket-tools.test.ts",
    "test:db": "DATABASE_URL=postgresql://firmos_admin:firmos_password@localhost:5432/firmos tsx tests/state/postgres.test.ts",
    "test:all": "npm test && npm run test:db",
    "test:stories": "tsx tests/stories/cli-onboarding.story.ts && tsx tests/stories/project-isolation.story.ts && tsx tests/stories/resilient-infra.story.ts && tsx tests/stories/ceo-handoff.story.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jameskranz/FirmOS.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jameskranz/FirmOS/issues"
  },
  "homepage": "https://github.com/jameskranz/FirmOS#readme",
  "dependencies": {
    "@google/genai": "^1.42.0",
    "@google/generative-ai": "^0.24.1",
    "amqplib": "^0.10.9",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "commander": "^14.0.3",
    "dockerode": "^4.0.9",
    "dotenv": "^17.3.1",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/blessed": "^0.1.27",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.16.0",
    "copyfiles": "^2.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
